---
# Update feed the vizi app polls. Served at https://vizi.science/releases/latest.json
# (GitHub Pages serves .json as application/json). Generated from _data/releases.yml
# at build — the publish workflow only writes the data file; Jekyll regenerates this.
# Shape matches vizi's update-feed contract: version, published, notes_url, page_url,
# downloads{windows,macos,linux}. "latest" is chosen by the eligibility rule in
# _data/releases.yml (newest published final; else newest published of any kind;
# else newest final; else newest).
---
{%- assign rels = site.data.releases.releases -%}
{%- assign pub_finals = rels | where_exp: "r", "r.prerelease != true" | where_exp: "r", "r.downloads.windows" -%}
{%- assign pub_any = rels | where_exp: "r", "r.downloads.windows" -%}
{%- assign all_finals = rels | where_exp: "r", "r.prerelease != true" -%}
{%- if pub_finals.size > 0 -%}{%- assign latest = pub_finals.first -%}
{%- elsif pub_any.size > 0 -%}{%- assign latest = pub_any.first -%}
{%- elsif all_finals.size > 0 -%}{%- assign latest = all_finals.first -%}
{%- else -%}{%- assign latest = rels.first -%}
{%- endif -%}
{%- assign anchor = latest.version | prepend: "/changelog.html#" | absolute_url -%}
{
  "version": {{ latest.version | jsonify }},
  "published": {{ latest.published | jsonify }},
  "notes_url": {{ anchor | jsonify }},
  "page_url": {{ anchor | jsonify }},
  "downloads": {
    "windows": {{ latest.downloads.windows | jsonify }},
    "macos": {{ latest.downloads.macos | jsonify }},
    "linux": {{ latest.downloads.linux | jsonify }}
  }
}
