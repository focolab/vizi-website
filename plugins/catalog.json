---
# Emitted from _data/plugins.yml at build (static; no backend). Served at
# https://vizi.science/plugins/catalog.json and read by the vizi app.
# Only LIVE entries (not `pending`) are included. Field contract is frozen —
# see _data/plugins.yml. The top-level `schema` lets the app refuse a shape it
# does not know.
---
{
  "schema": {{ site.data.plugins.schema | jsonify }},
  "plugins": [
    {%- assign live = site.data.plugins.plugins | where_exp: "p", "p.pending != true" -%}
    {%- for p in live %}
    {
      "id": {{ p.id | jsonify }},
      "name": {{ p.name | jsonify }},
      "summary": {{ p.summary | jsonify }},
      "repo": {{ p.repo | jsonify }},
      "version": {{ p.version | jsonify }},
      "min_vizi": {{ p.min_vizi | jsonify }},
      "sdk_version": {{ p.sdk_version | jsonify }},
      "asset_url": {{ p.asset_url | jsonify }},
      "size": {{ p.size | jsonify }},
      "sha256": {{ p.sha256 | jsonify }},
      "permissions": {{ p.permissions | jsonify }}{% if p.platforms %},
      "platforms": {{ p.platforms | jsonify }}{% endif %}{% if p.extensions %},
      "extensions": {{ p.extensions | jsonify }}{% endif %}
    }{%- unless forloop.last %},{% endunless -%}
    {%- endfor %}
  ]
}
